{
  "name": "awtrix-pipewire-on-air",
  "version": "1.0.0",
  "description": "Monitor microphone and display an ON AIR indicator on Ulanzi TC001 running Awtrix",
  "module": "index.ts",
  "type": "module",
  "bin": {
    "awtrix-pipewire-on-air": "./index.ts"
  },
  "scripts": {
    "fmt": "treefmt",
    "typecheck": "bun run --bun tsc --noEmit",
    "check:lockfile": "bun install --frozen-lockfile --ignore-scripts",
    "check": "bun run typecheck && bun run check:lockfile && treefmt --ci",
    "test": "bun test test/*.test.ts",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov test/*.test.ts",
    "fixtures": "bun run test/fixtures/capture-fixtures.ts && bun fmt"
  },
  "keywords": [
    "awtrix",
    "ulanzi",
    "tc001",
    "pipewire",
    "microphone",
    "on-air",
    "indicator"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/meatcar/awtrix-pipewire-on-air"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/debug": "^4.1.13",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "debug": "^4.4.3"
  }
}
